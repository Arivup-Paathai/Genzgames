{
  "name": "mini-games-hub-arivup-paathai",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && vite build",
    "preview": "vite preview",
    "cap:init": "npx cap init",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "functions:install": "npm --prefix functions install",
    "functions:build": "npm --prefix functions run build",
    "deploy:game-backend": "firebase deploy --only functions,firestore:rules --project multi-games-hub",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor-community/admob": "^6.2.0",
    "@capacitor-firebase/authentication": "^6.3.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/status-bar": "^6.0.3",
    "firebase": "^11.10.0",
    "lucide-react": "^0.546.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
